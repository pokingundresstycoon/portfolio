---
import type { BuildLog, Profile } from '../lib/schema';
import Departures from './Departures.astro';

interface Props {
  profile: Profile;
  log: BuildLog;
}

const { profile, log } = Astro.props;
---

<section id="top" class="hero wrap">
  <p class="hero__status"><span class="hero__dot" aria-hidden="true"></span>{profile.statusLine}</p>
  <h1 class="display hero__name">{profile.name}</h1>
  <p class="display hero__role">{profile.role}</p>
  <div class="hero__board"><Departures profile={profile} log={log} /></div>
</section>

<style>
  /* Less room on top: the nav is out of sight up there, so nothing needs clearing. */
  .hero {
    padding-block: clamp(56px, 4.5vw, 64px) clamp(56px, 9vw, 112px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line-deep);
    color: var(--muted-deep);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 1.4s ease-in-out infinite;
  }
  .hero__name {
    margin-top: 28px;
    font-size: clamp(64px, 12.5vw, 184px);
    overflow-wrap: anywhere;
  }
  .hero__role {
    margin-top: 18px;
    font-size: clamp(26px, 4.2vw, 60px);
    line-height: 0.95;
    color: var(--accent);
  }
  .hero__board {
    margin-top: clamp(40px, 6vw, 64px);
    width: 100%;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
</style>
