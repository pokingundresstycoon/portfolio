---
const steps = [
  { title: 'Ad click', growth: true, text: 'Meta and TikTok ads' },
  { title: 'Shop loads', growth: false, text: 'On my servers' },
  { title: 'Order placed', growth: false, text: 'Fast checkout' },
  { title: 'Order confirmed', growth: true, text: 'Cash on delivery' },
  { title: 'Signal sent back', growth: true, text: 'Conversions API' },
];
const growth = ['Social Media Strategy & Community Management', 'Performance Marketing & Paid Acquisition', 'Campaign Analytics & Attribution'];
const infra = ['Platform & Reliability Engineering', 'Self-hosted Cloud Infrastructure', 'Observability & Incident Response'];

// The same loop in two shapes: a wide racetrack (1136×600) and a tall pill beside the list on
// narrower screens. The order dot and the stop pulses run on one 9 s clock in both. The order's
// offset-path in the styles below repeats these two paths (inline styles would break the CSP).
const WIDE = 'M280 90 H856 A220 210 0 0 1 856 510 H280 A220 210 0 0 1 280 90 Z';
const TALL = 'M28 4 A16 16 0 0 1 44 20 V340 A16 16 0 0 1 12 340 V20 A16 16 0 0 1 28 4 Z';
---

<section id="loop" class="loop">
  <div class="wrap">
    <div class="loop__head">
      <h2 class="display loop__title">From server <br />to sale</h2>
      <p class="loop__intro">Every order runs this loop. I run every stop.</p>
      <p class="loop__legend">
        <span><span class="key key--growth" aria-hidden="true"></span>Growth stop</span>
        <span><span class="key key--infra" aria-hidden="true"></span>Infrastructure stop</span>
      </p>
    </div>

    <div class="circuit">
      <svg class="circuit__track circuit__track--wide" viewBox="0 0 1136 600" aria-hidden="true">
        <path d={WIDE} class="rail" />
        <path d={WIDE} class="bed" />
        <path d={WIDE} class="ties" />
      </svg>
      <svg class="circuit__track circuit__track--tall" viewBox="0 0 56 360" aria-hidden="true">
        <path d={TALL} class="rail" />
        <path d={TALL} class="bed" />
        <path d={TALL} class="ties" />
      </svg>
      <span class="circuit__order" aria-hidden="true"></span>
      <span class="circuit__order circuit__order--trail1" aria-hidden="true"></span>
      <span class="circuit__order circuit__order--trail2" aria-hidden="true"></span>

      <ol class="circuit__stops">
        {
          steps.map((s, i) => (
            <li class:list={['stop', `stop--${i + 1}`, s.growth ? 'is-growth' : 'is-infra']}>
              <span class="stop__dot" aria-hidden="true" />
              <h3 class="stop__title">{s.title}</h3>
              <p class="stop__text">{s.text}</p>
              <span class="visually-hidden">{s.growth ? 'Growth stop' : 'Infrastructure stop'}</span>
            </li>
          ))
        }
      </ol>
      <p class="circuit__return">…and the next ad learns.</p>

      <ul class="circuit__services" aria-label="Services">
        {growth.map((x) => <li class="chip chip--growth">{x}</li>)}
        <li class="chip chip--meet">Conversion Signal Engineering</li>
        {infra.map((x) => <li class="chip">{x}</li>)}
      </ul>
    </div>

  </div>
  <a class="loop__live" href="https://status.paperbase.me" rel="noopener" data-live-status hidden>
    <span class="loop__dot" aria-hidden="true"></span>
    <span class="loop__live-text">Paperbase right now: <strong data-live-text></strong></span>
    <span aria-hidden="true">↗</span>
  </a>
</section>

<script>
  import '../scripts/status-line';
</script>

<style>
  .loop {
    padding-block: var(--section);
  }
  .loop__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .loop__title {
    font-size: var(--title-section);
    text-align: center;
  }
  .loop__intro {
    font-size: 18px;
    line-height: 1.5;
    color: var(--muted-deep);
    text-wrap: balance;
  }
  .loop__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    font-size: 14px;
    font-weight: 700;
    color: var(--muted-deep);
  }
  .loop__legend > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .key {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
  .key--growth,
  .is-growth .stop__dot {
    background: var(--accent);
  }
  .key--infra,
  .is-infra .stop__dot {
    background: var(--deep);
    box-shadow: inset 0 0 0 3px var(--tint);
  }

  /* ---- The circuit (shared) ---- */
  .circuit {
    position: relative;
    margin-top: 48px;
  }
  .circuit__track {
    position: absolute;
    top: 0;
    left: 0;
    overflow: visible;
    fill: none;
  }
  .rail {
    stroke: var(--line-deep);
  }
  .bed {
    stroke: var(--deep-2);
  }
  .ties {
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 2;
    stroke-dasharray: 2 12;
    stroke-linecap: round;
  }
  .circuit__order {
    position: absolute;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 7px rgba(255, 208, 0, 0.22), 0 0 28px 6px rgba(255, 208, 0, 0.55);
    offset-rotate: 0deg;
    offset-path: path('M280 90 H856 A220 210 0 0 1 856 510 H280 A220 210 0 0 1 280 90 Z');
    animation: circuit-travel 9s linear infinite;
  }
  .circuit__order--trail1 {
    width: 14px;
    height: 14px;
    box-shadow: none;
    opacity: 0.45;
    animation-delay: -0.16s;
  }
  .circuit__order--trail2 {
    width: 9px;
    height: 9px;
    box-shadow: none;
    opacity: 0.25;
    animation-delay: -0.32s;
  }
  @keyframes circuit-travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  .circuit__stops {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stop__dot {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    animation: stop-hit 9s ease-out infinite;
  }
  @keyframes stop-hit {
    0% {
      transform: scale(1.7);
      filter: brightness(1.4);
    }
    10%,
    100% {
      transform: scale(1);
      filter: none;
    }
  }
  .stop__title {
    font-size: 20px;
    font-weight: 800;
  }
  .stop__text {
    margin-top: 2px;
    font-size: 14px;
    color: var(--muted-deep);
  }
  .circuit__return {
    font-size: 14px;
    font-weight: 700;
    color: var(--peach);
  }
  .circuit__services {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-size: 13px;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-deep);
    color: var(--muted-deep);
  }
  .chip--growth {
    border-color: rgba(255, 208, 0, 0.6);
    color: var(--tint);
  }
  .chip--meet {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--deep);
  }

  /* ---- Wide: the racetrack, stops placed around it ---- */
  @media (min-width: 1200px) {
    .circuit {
      width: 1136px;
      height: 600px;
      margin-inline: auto;
    }
    .circuit__track--wide {
      width: 1136px;
      height: 600px;
    }
    .circuit__track--tall {
      display: none;
    }
    .circuit__track--wide .rail {
      stroke-width: 14;
    }
    .circuit__track--wide .bed {
      stroke-width: 8;
    }
    .stop {
      position: absolute;
      width: 260px;
      text-align: center;
    }
    .stop__dot {
      margin: -12px 0 0 -12px;
    }
    /* Label boxes are centred over or under their dot (x = 360 and 720 on the track). */
    .stop--1 {
      left: 230px;
      top: 22px;
    }
    .stop--2 {
      left: 590px;
      top: 22px;
    }
    .stop--3 {
      left: 830px;
      top: 276px;
      width: 216px;
      text-align: right;
    }
    .stop--4 {
      left: 590px;
      top: 532px;
    }
    .stop--5 {
      left: 230px;
      top: 532px;
    }
    .stop--1 .stop__dot,
    .stop--2 .stop__dot {
      left: 130px;
      top: 68px;
    }
    .stop--1 .stop__dot {
      animation-delay: 0.29s;
    }
    .stop--2 .stop__dot {
      animation-delay: 1.58s;
    }
    .stop--3 .stop__dot {
      left: 246px;
      top: 24px;
      animation-delay: 3.29s;
    }
    .stop--4 .stop__dot,
    .stop--5 .stop__dot {
      left: 130px;
      top: -22px;
    }
    .stop--4 .stop__dot {
      animation-delay: 4.99s;
    }
    .stop--5 .stop__dot {
      animation-delay: 6.28s;
    }
    .circuit__return {
      position: absolute;
      left: 96px;
      top: 290px;
      width: 160px;
    }
    .circuit__services {
      position: absolute;
      left: 300px;
      top: 140px;
      width: 536px;
      height: 320px;
      align-content: center;
      justify-content: center;
    }
  }

  /* ---- Narrower: a tall pill beside the list; the order runs down the stops and back up ---- */
  @media (max-width: 1199.98px) {
    .circuit {
      padding-left: 72px;
    }
    .circuit__track--wide {
      display: none;
    }
    .circuit__track--tall {
      width: 56px;
      height: 360px;
    }
    .circuit__track--tall .rail {
      stroke-width: 10;
    }
    .circuit__track--tall .bed {
      stroke-width: 5;
    }
    .circuit__order {
      offset-path: path('M28 4 A16 16 0 0 1 44 20 V340 A16 16 0 0 1 12 340 V20 A16 16 0 0 1 28 4 Z');
      width: 18px;
      height: 18px;
    }
    .circuit__order--trail1 {
      width: 11px;
      height: 11px;
    }
    .circuit__order--trail2 {
      width: 7px;
      height: 7px;
    }
    .stop {
      position: relative;
      height: 72px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .stop__dot {
      left: -28px;
      top: 36px;
      width: 20px;
      height: 20px;
      margin: -10px 0 0 -10px;
    }
    .stop--1 .stop__dot {
      animation-delay: 0.5s;
    }
    .stop--2 .stop__dot {
      animation-delay: 1.38s;
    }
    .stop--3 .stop__dot {
      animation-delay: 2.25s;
    }
    .stop--4 .stop__dot {
      animation-delay: 3.12s;
    }
    .stop--5 .stop__dot {
      animation-delay: 4s;
    }
    .stop__title {
      font-size: 18px;
    }
    .circuit__return {
      margin-top: 14px;
    }
    .circuit__services {
      margin: 32px 0 0 -72px;
      justify-content: center;
    }
  }

  /* ---- Live status line ---- */
  /* A small pill in the section's top padding, above the headline: showing it pushes nothing, and
     hiding it leaves no empty block. */
  .loop {
    position: relative;
  }
  .loop__live {
    position: absolute;
    top: clamp(18px, 4vw, 44px);
    left: 50%;
    translate: -50% 0;
    max-width: calc(100% - 2 * var(--gutter));
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--line-deep);
    border-radius: 999px;
    background: var(--deep-2);
    color: var(--tint);
    font-size: clamp(12px, 3.4vw, 14px);
    text-decoration: none;
    white-space: nowrap;
  }
  .loop__live[hidden] {
    display: none;
  }
  .loop__live:hover {
    border-color: var(--muted-deep);
  }
  .loop__live-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .loop__dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--live);
  }
  .loop__live[data-level='degraded'] .loop__dot,
  .loop__live[data-level='maintenance'] .loop__dot {
    background: #ffc93c;
  }
  .loop__live[data-level='partial'] .loop__dot,
  .loop__live[data-level='major'] .loop__dot {
    background: var(--accent);
  }
</style>
