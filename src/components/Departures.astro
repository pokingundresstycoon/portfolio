---
import { PLANE as plane } from '../lib/plane';
import type { BuildLog, Profile } from '../lib/schema';

interface Props {
  profile: Profile;
  log: BuildLog;
}

const { profile, log } = Astro.props;
const flights = [
  {
    code: 'MR01',
    cls: 'Growth class',
    from: 'Server',
    to: 'Sale',
    facts: [
      { num: profile.numbers.orders, label: 'orders' },
      { num: profile.numbers.sales, label: 'in sales' },
    ],
  },
  {
    code: 'MR02',
    cls: 'Infra class',
    from: 'Commit',
    to: 'Live',
    facts: [
      { num: log.shopsLive, label: 'shops live' },
      { num: log.uptime.value, label: 'uptime' },
    ],
  },
  { code: 'MR03', cls: 'Both classes', from: 'Your idea', to: 'Launch', invite: true },
];
// Every route word gets the same number of tiles, so the columns line up like a real board.
const tiles = (word: string, n: number) => [...word.toUpperCase().padEnd(n)].map((c) => (c === ' ' ? ' ' : c));
---

<div class="dep" data-departures>
  <div class="dep__head">
    <h2 class="display dep__title"><svg class="dep__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={plane} />Departures</h2>
    <p class="dep__clock" data-clock>
      <span class="dep__clock-label">Local time <br />in Dhaka</span>
      <span class="dep__flaps" aria-hidden="true">{[...'00:00'].map(() => <span class="flap">{'\u00a0'}</span>)}</span>
      <time class="visually-hidden" data-clock-time></time>
    </p>
  </div>
  <ol class="dep__list">
    {
      flights.map((f) => (
        <li class:list={['dep__row', f.invite && 'dep__row--invite']} data-flight>
          <div class="dep__flight">
            <p class="display dep__code">{f.code}</p>
            <p class="dep__class">{f.cls}</p>
          </div>
          <p class="visually-hidden" data-route>
            {f.from} to {f.to}
          </p>
          <div class="dep__route" aria-hidden="true">
            <span class="dep__flaps" data-flaps="from">
              {tiles(f.from, 9).map((c) => (
                <span class="flap">{c}</span>
              ))}
            </span>
            <svg class="dep__plane" viewBox="0 0 24 24" set:html={plane} />
            <span class="dep__flaps" data-flaps="to">
              {tiles(f.to, 6).map((c) => (
                <span class="flap">{c}</span>
              ))}
            </span>
          </div>
          <div class="dep__remark">
            {f.facts && (
              <ul class="dep__facts">
                {f.facts.map((x) => (
                  <li class="dep__fact" data-fact>
                    <span class="display dep__num" data-num>{x.num}</span>{' '}
                    <span class="dep__label" data-label>{x.label}</span>
                  </li>
                ))}
              </ul>
            )}
            {f.invite && (
              <>
                <p class="display dep__boarding">Now boarding</p>
                <a class="dep__book" href="/#contact">
                  Book a seat
                </a>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import '../scripts/departures';
  import '../scripts/dhaka-clock';
</script>

<style>
  .dep {
    --board: #121418;
    background: var(--board);
    border-radius: 24px;
    padding: clamp(18px, 3vw, 34px);
    box-shadow:
      inset 0 0 0 1px rgba(236, 238, 241, 0.08),
      0 30px 60px rgba(0, 0, 0, 0.35);
    color: var(--tint);
    text-align: left;
    container-type: inline-size;
  }
  .dep__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 16px;
    padding-bottom: clamp(14px, 2vw, 20px);
  }
  .dep__title {
    display: flex;
    align-items: center;
    gap: 0.25em;
    font-size: clamp(40px, 5cqi, 56px);
  }
  .dep__icon {
    width: 0.8em;
    height: 0.8em;
    fill: var(--accent);
  }
  .dep__clock {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Until the script sets the time, the clock holds its place but shows nothing. */
  .dep__clock:not([data-ticking]) {
    visibility: hidden;
  }
  .dep__clock-label {
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.3;
    text-align: right;
    color: var(--muted-deep);
  }
  .dep__clock .flap {
    --w: 26px;
  }
  .dep__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dep__row {
    display: grid;
    grid-template-columns: minmax(0, 120px) auto minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(236, 238, 241, 0.08);
  }
  /* Lines only between flights. */
  .dep__row:last-child {
    border-bottom: 0;
  }
  .dep__code {
    font-size: 26px;
  }
  .dep__class {
    margin-top: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted-deep);
  }
  .dep__route {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dep__flaps {
    display: flex;
    gap: 3px;
  }
  .dep__plane {
    width: 22px;
    height: 22px;
    flex: none;
    fill: var(--accent);
  }
  .dep__remark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 10px 14px;
  }
  /* The facts in big type, each number on one line with its label; a pair that runs out of room
     drops to two lines rather than split a fact. */
  .dep__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dep__fact {
    display: flex;
    align-items: baseline;
    gap: 7px;
    white-space: nowrap;
  }
  .dep__num,
  .dep__boarding {
    font-size: clamp(28px, 3.4cqi, 40px);
  }
  .dep__label {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted-deep);
  }
  .dep__boarding {
    color: var(--accent);
    white-space: nowrap;
  }
  .dep__book {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--deep);
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  /* The tiles themselves are styled site-wide (global.css); the board sets their size. */
  .flap {
    --w: clamp(18px, 2.85cqi, 31px);
  }
  .dep__row--invite .flap {
    color: var(--accent);
  }

  /* Narrow boards: each flight stacks, from on one line and to on the next. */
  @container (max-width: 760px) {
    .dep__title {
      font-size: clamp(32px, 12cqi, 44px);
    }
    .dep__clock .flap {
      --w: 22px;
    }
    .dep__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }
    .dep__flight {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 10px;
    }
    /* From takes a whole line; the plane and to wrap onto the next one together. */
    .dep__route {
      flex-wrap: wrap;
      gap: 6px 8px;
    }
    .dep__flaps[data-flaps='from'] {
      flex-basis: 100%;
    }
    .dep__remark {
      justify-content: space-between;
    }
    .dep__facts {
      justify-content: flex-start;
      gap: 6px 22px;
    }
    .dep__num,
    .dep__boarding {
      font-size: clamp(26px, 9cqi, 34px);
    }
    .flap {
      --w: min(31px, calc((100cqi - 8 * 3px) / 9.4));
    }
  }
</style>
