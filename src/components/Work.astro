---
import { monthsSince } from '../lib/build-log';
import { isoScene } from '../lib/iso';
import { MERGE_SCENE } from '../lib/merge-scene';
import type { BuildLog, Profile } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  log: BuildLog;
  numbers: Profile['numbers'];
  /** Link to a growth case study, once there is one. */
  growthStory: string | null;
}

const { log, numbers, growthStory } = Astro.props;
const facts = [
  ['months building', String(monthsSince(log.started))],
  ['commits', log.commits],
  [log.uptime.label, log.uptime.value],
  ['shops live', log.shopsLive],
];
const merge = isoScene(MERGE_SCENE.items, MERGE_SCENE);
---

<section id="work" class="work">
  <div class="wrap">
    <div class="work__head">
      <h2 class="display work__title">Selected work</h2>
      <p class="work__sub">The commerce platform I build and run, and the ads that fill its shops.</p>
    </div>

    <div class="work__story">
      <article class="pb" data-paperbase>
        <p class="pb__eyebrow">Built and run by me</p>
        <h3 class="display pb__name">Paperbase</h3>
        <p class="pb__about">
          A commerce platform for sellers in Bangladesh: their shop, their orders, their couriers and their ads, in one
          place.
        </p>
        <dl class="pb__facts">
          {
            facts.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd class="display">{value}</dd>
              </div>
            ))
          }
        </dl>
        <a class="pb__more" href="/work/paperbase/">
          Read the full story <span class="pb__arrow"><Icon name="arrow-up-right" size={14} stroke={2.4} /></span>
        </a>
      </article>

      <ol class="log" data-log>
        {
          log.milestones.map((m) => (
            <li class="log__item">
              <p class="log__when" data-when>
                {m.when}
              </p>
              <h3 class="log__title">{m.title}</h3>
              <p class="log__text">{m.text}</p>
              {m.visual === 'merge' && (
                <svg class="merge" data-merge viewBox={`0 0 ${MERGE_SCENE.width} ${MERGE_SCENE.height}`} aria-hidden="true">
                  {merge.map((shape) =>
                    shape.kind === 'box' ? (
                      <g class:list={[`m-${shape.material}`, shape.part]}>
                        {shape.faces.map((f) => (
                          <polygon class={f.side} points={f.points} />
                        ))}
                      </g>
                    ) : shape.kind === 'poly' ? (
                      <polygon class={shape.part} points={shape.points} />
                    ) : (
                      <polyline class={shape.part} points={shape.points} />
                    ),
                  )}
                </svg>
              )}
              {m.link && (
                <a class="log__link" href={m.link.href} target="_blank" rel="noopener">
                  {m.link.label} <Icon name="arrow-up-right" size={13} stroke={2.4} />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="growth" data-growth>
      <div class="growth__copy">
        <p class="growth__eyebrow">The other half: the buyers</p>
        <h3 class="growth__title">The ads that bring buyers to shops like these.</h3>
        <p class="growth__text">From the Facebook pages and ad accounts I’ve run for online sellers. Clients kept private.</p>
        {
          growthStory && (
            <a class="growth__more" href={growthStory}>
              Read a growth story <Icon name="arrow-up-right" size={14} stroke={2.4} />
            </a>
          )
        }
      </div>
      <dl class="growth__numbers">
        <div>
          <dt>orders</dt>
          <dd class="display">{numbers.orders}</dd>
        </div>
        <div>
          <dt>in sales</dt>
          <dd class="display">{numbers.sales}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .work {
    --focus: var(--deep);
    background: var(--tint);
    color: var(--deep);
    padding-block: var(--section);
  }
  .work__head {
    text-align: center;
  }
  .work__title {
    font-size: var(--title-section);
    text-align: center;
  }
  .work__sub {
    margin-top: 16px;
    font-size: 17px;
    color: var(--muted-tint);
    text-align: center;
    text-wrap: balance;
  }

  /* The Paperbase card beside its build log. On a laptop the card stays put while the log scrolls. */
  .work__story {
    margin-top: clamp(40px, 5vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }
  .pb {
    position: sticky;
    top: 96px;
    padding: clamp(26px, 3vw, 34px);
    border-radius: 30px;
    background: var(--deep);
    color: var(--tint);
    --focus: var(--accent);
  }
  .pb__eyebrow {
    font-size: 13px;
    font-weight: 800;
    color: var(--peach);
  }
  .pb__name {
    margin-top: 14px;
    font-size: clamp(56px, 6vw, 76px);
  }
  .pb__about {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted-deep);
  }
  .pb__facts {
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
  }
  /* Each fact reads value first, label under it; the markup keeps the label first for readers. */
  .pb__facts div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
  }
  .pb__facts dt {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--muted-deep);
  }
  .pb__facts dd {
    margin: 0;
    font-size: clamp(40px, 4vw, 46px);
  }
  .pb__more {
    margin-top: 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    font-weight: 800;
    color: var(--tint);
    text-decoration: none;
  }
  .pb__arrow {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--tint);
    color: var(--deep);
  }

  .log {
    margin: 0;
    padding: 6px 0 0;
    list-style: none;
  }
  .log__item {
    position: relative;
    padding: 0 0 28px 36px;
  }
  .log__item:last-child {
    padding-bottom: 0;
  }
  /* A square marker per step, joined by a rail; the first and last steps in orange. */
  .log__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 3px;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--deep);
  }
  .log__item:first-child::before,
  .log__item:last-child::before {
    background: var(--accent);
    /* Yellow alone barely shows on the pale page; a graphite edge does. */
    box-shadow: inset 0 0 0 2px var(--deep);
  }
  .log__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 22px;
    bottom: 0;
    width: 2px;
    background: var(--line-tint);
  }
  .log__when {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--muted-tint);
  }
  .log__title {
    margin-top: 6px;
    font-size: 21px;
    font-weight: 800;
    line-height: 1.3;
  }
  .log__text {
    margin-top: 6px;
    max-width: 560px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted-tint);
  }
  .log__link {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 800;
    color: var(--deep);
  }
  /* Five pale shop servers become one stack, lit in the accent: the How I work drawing style. */
  .merge {
    display: block;
    margin-top: 14px;
    width: 340px;
    max-width: 100%;
    height: auto;
  }
  .m-ice .t {
    fill: var(--card);
  }
  .m-ice .l {
    fill: var(--line-tint);
  }
  .m-ice .r {
    fill: var(--muted-deep);
  }
  .m-navy .t {
    fill: #4a505c;
  }
  .m-navy .l {
    fill: var(--deep-2);
  }
  .m-navy .r {
    fill: var(--deep);
  }
  .led {
    fill: var(--accent);
  }
  .led--off {
    fill: #8a909b;
  }
  .arrow {
    fill: none;
    stroke: var(--deep);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The growth half: the ads that bring the buyers. */
  .growth {
    margin-top: 24px;
    padding: clamp(26px, 3vw, 34px) clamp(26px, 3.5vw, 40px);
    border-radius: 30px;
    background: var(--accent);
    color: var(--deep);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 40px;
    align-items: center;
  }
  .growth__eyebrow {
    font-size: 13px;
    font-weight: 800;
  }
  .growth__title {
    margin-top: 10px;
    max-width: 460px;
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 800;
    line-height: 1.25;
  }
  .growth__text {
    margin-top: 10px;
    max-width: 460px;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
  }
  .growth__more {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 800;
    color: var(--deep);
  }
  .growth__numbers {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }
  .growth__numbers div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }
  .growth__numbers dt {
    font-size: 13px;
    font-weight: 800;
  }
  .growth__numbers dd {
    margin: 0;
    font-size: clamp(52px, 7vw, 84px);
  }

  /* Phones and small tablets: one column, the card first. */
  @media (max-width: 900px) {
    .work__story {
      grid-template-columns: minmax(0, 1fr);
    }
    .pb {
      position: static;
    }
    .growth {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .log__item {
      padding-left: 28px;
    }
    .log__title {
      font-size: 18px;
    }
    .log__text {
      font-size: 14.5px;
    }
  }
</style>
