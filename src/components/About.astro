---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { contactLinks } from '../lib/contact';
import type { Profile } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const links = contactLinks(profile);
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = profile.photo ? photos[`/src/assets/${profile.photo}`]?.default : undefined;
if (profile.photo && !photo) throw new Error(`profile.photo "${profile.photo}" is not in src/assets/`);

// The two crafts, each with where most people in it stop.
const halves = [
  { key: 'engineer', kind: 'infra', title: 'The engineer', claim: 'I build the systems online shops run on.', limit: 'Most engineers stop at the server.' },
  { key: 'marketer', kind: 'growth', title: 'The marketer', claim: 'I run the ads and pages that fill them with buyers.', limit: 'Most marketers stop at the click.' },
];
---

<section id="about" class="about">
  <div class="wrap">
    <h2 class="display about__title">Two crafts. <br />One operator.</h2>
    <!-- Two halves in the site's two colours, and the photo on the seam between them. -->
    <div class="halves">
      {
        halves.map((h) => (
          <div class:list={['half', `half--${h.kind}`]} data-half={h.key}>
            <h3 class="half__title">{h.title}</h3>
            <p class="display half__claim">{h.claim}</p>
            <p class="half__limit">{h.limit}</p>
          </div>
        ))
      }
      <figure class="about__photo" data-photo>
        {
          photo ? (
            <Image src={photo} alt={`${profile.name}, smiling`} width={440} loading="lazy" draggable="false" />
          ) : (
            <div class="about__placeholder">
              <Icon name="person" size={36} stroke={1.5} />
              <span>Your photo</span>
            </div>
          )
        }
      </figure>
    </div>
    <div class="about__close">
      <div>
        <p class="about__lead">I don’t stop. I follow every order all the way to the confirmed sale.</p>
        <p class="about__text">I’m Mushfikur. Most people call me Mahi. Founder of Paperbase, based in Dhaka, working worldwide.</p>
      </div>
      <div class="about__actions">
        <a href="#work" class="about__cta">See my work <Icon name="arrow-up-right" size={15} stroke={2.4} /></a>
        <a href={profile.github} class="about__icon" aria-label="GitHub" rel="noopener"><Icon name="github" size={20} /></a>
        {
          links.whatsapp && (
            <a href={links.whatsapp} class="about__icon" aria-label="WhatsApp" rel="noopener">
              <Icon name="whatsapp" size={20} />
            </a>
          )
        }
        <a href={links.email} class="about__icon" aria-label="Email"><Icon name="mail" size={20} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    --photo: clamp(150px, 16vw, 200px);
    --ring: clamp(7px, 0.8vw, 10px);
    --focus: var(--deep);
    background: var(--tint);
    color: var(--deep);
    padding-block: var(--section);
  }
  .about__title {
    font-size: var(--title-section);
    margin-bottom: clamp(36px, 5vw, 64px);
    text-align: center;
  }

  /* Wide screens: the halves side by side, the photo over the line between them. */
  .halves {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-radius: 28px;
  }
  .half {
    display: flex;
    flex-direction: column;
    min-height: clamp(340px, 31vw, 400px);
    padding: clamp(28px, 3.4vw, 44px);
  }
  /* The inner sides keep clear of the photo: half its width, its ring and a gap. */
  /* Each half is pinned to its cell: the photo shares them, and auto-placement would move the
     halves out of its way. */
  .half--infra {
    grid-area: 1 / 1;
    padding-right: calc(var(--photo) / 2 + var(--ring) + 40px);
    border-radius: 28px 0 0 28px;
    background: var(--deep);
    color: var(--tint);
  }
  .half--growth {
    grid-area: 1 / 2;
    padding-left: calc(var(--photo) / 2 + var(--ring) + 40px);
    border-radius: 0 28px 28px 0;
    background: var(--accent);
    color: var(--deep);
  }
  .half__title {
    font-size: 14px;
    font-weight: 700;
  }
  .half--infra .half__title,
  .half--infra .half__limit {
    color: var(--muted-deep);
  }
  .half__claim {
    margin-top: 14px;
    font-size: clamp(38px, 4.5vw, 58px);
    text-wrap: balance;
  }
  .half__limit {
    margin-top: auto;
    padding-top: 40px;
    font-size: 17px;
    font-weight: 600;
  }
  .about__photo {
    grid-row: 1;
    grid-column: 1 / -1;
    place-self: center;
    z-index: 1;
    margin: 0;
    width: var(--photo);
    aspect-ratio: 1;
    border-radius: 50%;
    border: var(--ring) solid var(--tint);
    position: relative;
    overflow: hidden;
    /* The ring's colour, so the photo's anti-aliased edge blends into the ring. */
    background: var(--tint);
  }
  /* Rounded itself too: clipped by the circle alone, Chrome leaves a dark hairline at its edge. */
  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  /* Sized by the circle itself: the circle has no set height, only its ratio. */
  .about__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: var(--deep-2);
    color: var(--muted-deep);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .about__close {
    margin-top: 40px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 80px;
    align-items: end;
  }
  .about__lead {
    max-width: 640px;
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 800;
    line-height: 1.3;
    text-wrap: balance;
  }
  .about__text {
    margin-top: 14px;
    max-width: 640px;
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.6;
    color: var(--muted-tint);
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .about__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--deep);
    color: var(--tint);
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }
  .about__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--line-tint);
    background: var(--card);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .about__icon:hover {
    border-color: var(--deep);
  }

  /* Narrow screens: the halves stack, and the photo hangs from the top of the second one, so it
     stays on the seam whatever the halves' heights. */
  @media (max-width: 900px) {
    .about {
      --photo: clamp(116px, 30vw, 160px);
    }
    .halves {
      grid-template-columns: minmax(0, 1fr);
    }
    .half {
      min-height: 0;
      padding: 26px 22px;
    }
    .half--infra {
      padding-right: 22px;
      padding-bottom: calc(var(--photo) / 2 + var(--ring) + 24px);
      border-radius: 24px 24px 0 0;
    }
    .half--growth {
      grid-area: 2 / 1;
      padding-left: 22px;
      padding-top: calc(var(--photo) / 2 + var(--ring) + 24px);
      border-radius: 0 0 24px 24px;
    }
    .half__claim {
      margin-top: 10px;
      font-size: clamp(30px, 8vw, 44px);
    }
    .half__limit {
      padding-top: 14px;
      font-size: 15px;
    }
    .about__photo {
      grid-row: 2;
      grid-column: 1;
      align-self: start;
      justify-self: center;
      translate: 0 -50%;
    }
    .about__close {
      margin-top: 28px;
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
