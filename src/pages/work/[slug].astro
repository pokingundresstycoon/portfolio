---
import { getCollection, render } from 'astro:content';
import Contact from '../../components/Contact.astro';
import Icon from '../../components/Icon.astro';
import Nav from '../../components/Nav.astro';
import Base from '../../layouts/Base.astro';
import { loadProfile } from '../../lib/load';
import { parseWork } from '../../lib/schema';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.filter((e) => parseWork([e])[0].story).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const [work] = parseWork([entry]);
const { Content } = await render(entry);
const linkHost = work.link ? new URL(work.link).host : null;
---

<Base title={`${work.title} · Mushfikur Rahman`} description={work.summary} path={`/work/${entry.id}/`}>
  <Nav />
  <main class="story wrap">
    <a href="/#work" class="story__back"><Icon name="arrow" size={16} stroke={2.2} />Back to work</a>
    <p class="story__chip">{work.chip}</p>
    <h1 class="display story__title">{work.title}</h1>
    <p class="story__summary">{work.summary}</p>
    {work.link && <a class="story__visit" href={work.link} rel="noopener">Visit {linkHost} ↗</a>}
    <div class="story__body"><Content /></div>
  </main>
  <Contact profile={loadProfile()} />
</Base>

<style>
  .story {
    padding-block: clamp(48px, 8vw, 96px);
    max-width: 820px;
  }
  .story__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
    color: var(--muted-deep);
  }
  .story__back :global(svg) {
    rotate: 180deg;
  }
  .story__chip {
    margin-top: 32px;
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--deep);
  }
  .story__title {
    margin-top: 18px;
    font-size: clamp(64px, 11vw, 140px);
    overflow-wrap: anywhere;
  }
  .story__summary {
    margin-top: 16px;
    font-size: 20px;
    color: var(--muted-deep);
  }
  .story__visit {
    display: inline-flex;
    margin-top: 20px;
    min-height: 44px;
    align-items: center;
    font-weight: 700;
    color: var(--accent);
  }
  .story__body {
    margin-top: 40px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted-deep);
  }
  .story__body :global(h2) {
    margin: 40px 0 12px;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 36px;
    line-height: 0.95;
    color: var(--tint);
  }
  .story__body :global(p + p) {
    margin-top: 16px;
  }
  .story__body :global(a) {
    color: var(--accent);
  }
</style>
